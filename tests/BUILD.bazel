load("@rules_cc//cc:defs.bzl", "cc_test")

DOCTEST_DEPS = ["@doctest//:main"]

cc_test(
    name = "game_rules_test",
    srcs = [
        "board_runout_test.cc",
        "game_rules_test.cc",
        "game_state_test.cc",
        "rules_test_support.h",
    ],
    deps = [
        "//src:bet_abstraction",
        "//src:poker",
        "@doctest//:main",
    ],
)

POKER_TEST_DEPS = DOCTEST_DEPS + [
    "//src:bet_abstraction",
    "//src:evaluation",
    "//src:policy_codec",
    "//src:solver",
]

cc_test(
    name = "card_utils_test",
    srcs = ["card_utils_test.cc"],
    deps = POKER_TEST_DEPS,
)

cc_test(
    name = "cfr_solver_test",
    srcs = ["cfr_solver_test.cc"],
    deps = POKER_TEST_DEPS,
)

cc_test(
    name = "policy_codec_test",
    srcs = ["policy_codec_test.cc"],
    deps = POKER_TEST_DEPS,
)

cc_test(
    name = "training_range_test",
    srcs = ["training_range_test.cc"],
    deps = POKER_TEST_DEPS,
)

test_suite(
    name = "poker_test",
    tests = [
        ":card_utils_test",
        ":cfr_solver_test",
        ":policy_codec_test",
        ":training_range_test",
    ],
)

cc_test(
    name = "card_abstraction_modes_test",
    srcs = ["strict_abstraction_test.cc"],
    deps = DOCTEST_DEPS + ["//src:solver"],
)

cc_test(
    name = "deep_cfr_test",
    srcs = ["deep_cfr_test.cc"],
    deps = DOCTEST_DEPS + [
        "//src:deep_cfr",
        "//src:neural_policy",
    ],
)

cc_test(
    name = "neural_policy_test",
    srcs = ["neural_policy_test.cc"],
    deps = DOCTEST_DEPS + [
        "//src:bet_abstraction",
        "//src:neural_evaluation",
        "//src:neural_policy",
    ],
)
